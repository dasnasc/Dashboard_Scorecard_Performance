model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["f_base_score","d_calendario","d_cesta_indicadores_plataforma","d_medidas"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

ref table f_base_score
ref table d_calendario
ref table d_cesta_indicadores_plataforma
ref table d_medidas

ref cultureInfo pt-BR

