	measure 'Score Ponderado (Operador)' =
			
			VAR _PlataformaAtual = SELECTEDVALUE(f_base_score[operacao_origem_atual])
			RETURN
				IF(
					NOT ISBLANK(_PlataformaAtual),
					CALCULATE(
						SUMX(
							FILTER(
								d_cesta_indicadores_plataforma,
								d_cesta_indicadores_plataforma[plataforma] = _PlataformaAtual
							),
							VAR _Indicador = d_cesta_indicadores_plataforma[indicador]
							VAR _Direcao = d_cesta_indicadores_plataforma[direcao_meta]
							VAR _Peso = d_cesta_indicadores_plataforma[peso]
							VAR _Realizado =
								SWITCH(
									_Indicador,
									"tma", [TMA],
									"transferencia", [Transferência],
									"aderencia", [Aderência],
									"abs", [ABS],
									"csat", [CSAT],
									"nps", [NPS],
									"monitoria", [Monitoria],
									"produtividade", [Produtividade]
								)
							VAR _Meta =
								SWITCH(
									_Indicador,
									"tma", AVERAGE(f_base_score[meta_tma]),
									"transferencia", AVERAGE(f_base_score[meta_transferencia_pesquisa]),
									"aderencia", AVERAGE(f_base_score[meta_aderencia]),
									"abs", AVERAGE(f_base_score[meta_abs]),
									"csat", AVERAGE(f_base_score[meta_csat]),
									"nps", AVERAGE(f_base_score[meta_nps]),
									"monitoria", AVERAGE(f_base_score[meta_monitoria]),
									"produtividade", AVERAGE(f_base_score[meta_produtividade])
								)
							VAR _Atingimento =
								IF(
									ISBLANK(_Realizado),
									BLANK(),
									IF(
										_Direcao = "menor_melhor",
										IF(_Realizado = 0, 1, DIVIDE(_Meta, _Realizado)),
										DIVIDE(_Realizado, _Meta)
									)
								)
							RETURN
								_Peso * _Atingimento
						),
						f_base_score[operacao_origem_historico] = _PlataformaAtual
					)
				)
		formatString: 0%
		displayFolder: Score e Ranking
		lineageTag: dbbc44f0-6103-4a98-8324-e8fafbfe66f8

	measure 'Score Ponderado (Plataforma)' =
			
			VAR _PlataformaHistorica = SELECTEDVALUE(f_base_score[operacao_origem_historico])
			RETURN
				IF(
					NOT ISBLANK(_PlataformaHistorica),
					SUMX(
						FILTER(
							d_cesta_indicadores_plataforma,
							d_cesta_indicadores_plataforma[plataforma] = _PlataformaHistorica
						),
						VAR _Indicador = d_cesta_indicadores_plataforma[indicador]
						VAR _Direcao = d_cesta_indicadores_plataforma[direcao_meta]
						VAR _Peso = d_cesta_indicadores_plataforma[peso]
						VAR _Realizado =
							SWITCH(
								_Indicador,
								"tma", [TMA],
								"transferencia", [Transferência],
								"aderencia", [Aderência],
								"abs", [ABS],
								"csat", [CSAT],
								"nps", [NPS],
								"monitoria", [Monitoria],
								"produtividade", [Produtividade]
							)
						VAR _Meta =
							SWITCH(
								_Indicador,
								"tma", AVERAGE(f_base_score[meta_tma]),
								"transferencia", AVERAGE(f_base_score[meta_transferencia_pesquisa]),
								"aderencia", AVERAGE(f_base_score[meta_aderencia]),
								"abs", AVERAGE(f_base_score[meta_abs]),
								"csat", AVERAGE(f_base_score[meta_csat]),
								"nps", AVERAGE(f_base_score[meta_nps]),
								"monitoria", AVERAGE(f_base_score[meta_monitoria]),
								"produtividade", AVERAGE(f_base_score[meta_produtividade])
							)
						VAR _Atingimento =
							IF(
								ISBLANK(_Realizado),
								BLANK(),
								IF(
									_Direcao = "menor_melhor",
									IF(_Realizado = 0, 1, DIVIDE(_Meta, _Realizado)),
									DIVIDE(_Realizado, _Meta)
								)
							)
						RETURN
							_Peso * _Atingimento
					)
				)
		formatString: 0%
		displayFolder: Score e Ranking
		lineageTag: bbe48b67-9c0b-47eb-b956-581472e30a0e

	measure 'Ranking Geral (Operador)' =
			
			RANKX(
				ALL(f_base_score[id_do_funcionario]),
				[Score Ponderado (Operador)],
				,
				DESC,
				DENSE
			)
		formatString: 0
		displayFolder: Score e Ranking
		lineageTag: 7aea7593-80c4-40a4-a9ec-2e7b4f2babb8

	measure 'Ranking na Plataforma (Operador)' =
			
			VAR _PlataformaAtual = SELECTEDVALUE(f_base_score[operacao_origem_atual])
			RETURN
				RANKX(
					FILTER(
						ALL(f_base_score[id_do_funcionario], f_base_score[operacao_origem_atual]),
						f_base_score[operacao_origem_atual] = _PlataformaAtual
					),
					[Score Ponderado (Operador)],
					,
					DESC,
					DENSE
				)
		formatString: 0
		displayFolder: Score e Ranking
		lineageTag: 8b894c42-3539-4b10-afe4-21ac8db1c723

	measure 'Ranking por Plataforma' =
			
			RANKX(
				ALL(f_base_score[operacao_origem_historico]),
				[Score Ponderado (Plataforma)],
				,
				DESC,
				DENSE
			)
		formatString: 0
		displayFolder: Score e Ranking
		lineageTag: 493f1523-e532-4ef5-933e-6c3a22c10cab

	measure 'Quartil TMA' =
			
			VAR _PlataformaAtual = SELECTEDVALUE(f_base_score[operacao_origem_atual])
			VAR _Pares =
				FILTER(
					ALL(f_base_score[id_do_funcionario], f_base_score[operacao_origem_atual]),
					f_base_score[operacao_origem_atual] = _PlataformaAtual
				)
			VAR _TotalPares = COUNTROWS(_Pares)
			VAR _Posicao =
				RANKX(
					_Pares,
					CALCULATE([TMA], f_base_score[operacao_origem_historico] = _PlataformaAtual),
					,
					ASC,
					DENSE
				)
			VAR _Percentil = DIVIDE(_Posicao, _TotalPares)
			RETURN
				IF(
					ISBLANK(_PlataformaAtual) || ISBLANK(_Percentil),
					BLANK(),
					SWITCH(
						TRUE(),
						_Percentil <= 0.25, 1,
						_Percentil <= 0.5, 2,
						_Percentil <= 0.75, 3,
						4
					)
				)
		formatString: 0
		displayFolder: Quartis
		lineageTag: 5181b643-c1cb-48bf-a0bc-0d03e5fd3746

