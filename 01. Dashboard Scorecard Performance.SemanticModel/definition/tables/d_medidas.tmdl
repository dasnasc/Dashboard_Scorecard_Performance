table d_medidas
	lineageTag: 0aaf9625-c95a-4584-abd8-1a6d9749e7d8

	measure TMA = DIVIDE(SUM(f_base_score[tempo_de_atendimento]), SUM(f_base_score[chamadas_atendidas_total]))
