	measure CSAT = DIVIDE(SUMX(f_base_score, f_base_score[nota_csat] * f_base_score[qtd_pesquisas]), SUM(f_base_score[qtd_pesquisas]))
		displayFolder: Indicadores
		lineageTag: 5c229bc5-7ce3-44aa-b239-6f914e047186

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure NPS = DIVIDE(100 * (SUM(f_base_score[qtd_promotores]) - SUM(f_base_score[qtd_detratores])), SUM(f_base_score[qtd_pesquisas]))
		displayFolder: Indicadores
		lineageTag: 149eb060-ae3f-494b-b39e-d1e452b473ae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

